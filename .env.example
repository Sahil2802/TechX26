# Copy to .env (gitignored) and fill in. Never commit real keys.
# Get keys: Groq https://console.groq.com/keys   Gemini (Google AI Studio) https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_MODEL=qwen3:4b
# Providers are tried in this order; those without a key are skipped. Ollama last = offline safety net.
LLM_CHAIN=groq,gemini,ollama
OPERATOR_TOKEN=change-me
AQUAGRID_DB=data/aquagrid.sqlite
